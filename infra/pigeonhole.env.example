# Copy to pigeonhole.env (gitignored) for the Docker path and fill in the
# secret. The systemd unit does not read this file: it carries the same
# non-secret settings as Environment= lines and takes the secret through
# LoadCredential= so it never sits in the process environment.
#
# Every variable the broker reads, with its built-in default where one
# exists. Validate a filled-in copy without binding the port:
#   set -a; . ./pigeonhole.env; set +a; pigeonhole --check

# Same value as dovecote's COAP_SERVICE_SECRET Worker secret. One value, one
# gate, whatever each side calls it. Required.
PIGEONHOLE_SERVICE_SECRET=

# PEM chain (leaf first) and its private key. Required; the broker refuses
# to start without a servable pair, there being no cleartext fallback.
#PIGEONHOLE_TLS_CERT=/tls/chain.pem
#PIGEONHOLE_TLS_KEY=/tls/key.pem

# TLS listen address. Dual-stack by default so one listener serves both the
# A and the AAAA record; a v4-only host sets 0.0.0.0:8883.
#PIGEONHOLE_LISTEN=[::]:8883

# Where the device routes and the device WebSocket are.
#PIGEONHOLE_DOVECOTE_URL=https://api.pidgeiot.com

# Positive PSK cache TTL, seconds. A rotated PSK can complete a handshake
# for at most this long before the session's own upgrade refuses it.
#PIGEONHOLE_PSK_TTL_SECS=60

# Inbound silence on a device WebSocket before the bridge pings it, seconds.
# Two missed pongs replace the socket.
#PIGEONHOLE_FEED_PING_SECS=60

# tracing env filter.
#PIGEONHOLE_LOG=info
